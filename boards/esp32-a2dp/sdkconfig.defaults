# ESP-IDF compile-time configuration (Kconfig). This file is why the
# Bluetooth code compiles at all: esp-idf-svc's `bt` module is gated on
# these switches (embuild turns them into Rust cfg flags like
# `esp_idf_bt_enabled`), not on cargo features.

# Rust needs more main-task stack than C (these mirror esp-idf-template).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Bluetooth: the Bluedroid host stack with Classic (BR/EDR) + A2DP. See
# ADR 0008 for why Classic requires this C stack.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
# (No SSP switch here: ESP-IDF 5.3 removed CONFIG_BT_SSP_ENABLED — Secure
# Simple Pairing is always on for Classic now.)
# We only need Classic, but Bluedroid's BLE half must stay enabled anyway:
# esp-idf-svc (0.52) compiles its `bt::ble` bindings unconditionally whenever
# Bluedroid is on, and they reference `esp_ble_*` symbols that only exist
# with BLE enabled. Costs some RAM; revisit if upstream makes BLE optional.
CONFIG_BT_BLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
# Bluedroid's own callback task also needs headroom for our Rust callbacks.
CONFIG_BT_BTC_TASK_STACK_SIZE=15000
